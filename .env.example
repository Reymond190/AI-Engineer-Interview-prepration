# -------------------------------------------------------
# .env.example
# Copy to .env and fill in values.
# The .env file is excluded from git (see .gitignore).
# -------------------------------------------------------

# Hugging Face access token (only needed for private/gated models)
# DeepSeek-R1-Distill-Qwen-14B is public -- leave blank.
HF_TOKEN=

# Override default HF cache location (optional)
# Default: ~/.cache/huggingface
# Uncomment and set if you want the ~30 GB model stored elsewhere:
# HF_HOME=/path/to/large/drive/.cache/huggingface

# Local server base URL (used by the agent harness and tests)
AGENT_BASE_URL=http://localhost:8000/v1
